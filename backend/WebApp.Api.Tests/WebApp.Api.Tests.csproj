<Project Sdk="MSTest.Sdk/3.10.2">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebApp.Api\WebApp.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- In-memory host for integration tests of the real API pipeline (Lote 1). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pin transitive dependency to a patched version (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf,
         CVE-2026-47302 and related; affected <= 10.0.9). -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
    <!-- Transitive via Microsoft.Identity.Web.TokenCache: CVE-2026-40372 (critical, affected <= 10.0.6).
         The API itself uses the ASP.NET Core shared framework copy (fixed by the runtime of the image). -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.14" />
  </ItemGroup>

</Project>
